{
  "name": "minecraft-afk-bot",
  "private": true,
  "license": "MIT",
  "description": "Minecraft AFK bot built with Mineflayer",
  "main": "bot.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarkSpirit006/afk-bot.git"
  },
  "bugs": {
    "url": "https://github.com/DarkSpirit006/afk-bot/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bot.js",
    "afk": "node bot.js",
    "setup": "node setup.js",
    "update": "node setup.js --update",
    "migrate": "node setup.js --migrate",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "check": "node --check bot.js && node --check setup.js && node --check src/bot.js && node --test test/*.test.js"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "afk-bot",
    "minecraft-bot",
    "nodejs"
  ],
  "dependencies": {
    "dotenv": "^16.4.7",
    "minecraft-data": "^3.112.0",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-nbt": "^2.8.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "eslint": "^9.30.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
